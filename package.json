{
  "name": "agentsnap",
  "version": "1.0.0",
  "description": "Snapshot testing for AI coding agents — record, replay, and diff agent sessions to catch behavior regressions",
  "main": "dist/index.js",
  "bin": {
    "agentsnap": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && npx tsc && node --test dist/**/*.test.js",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "snapshot",
    "testing",
    "regression",
    "cli"
  ],
  "author": "sulthonzh",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sulthonzh/agentsnap.git"
  },
  "homepage": "https://github.com/sulthonzh/agentsnap#readme",
  "bugs": {
    "url": "https://github.com/sulthonzh/agentsnap/issues"
  }
}
